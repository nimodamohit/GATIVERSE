# SmartRail ETA Backend Environment Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartrail_eta
FRONTEND_URL=http://localhost:3000
ML_SERVICE_URL=http://localhost:8000
NODE_ENV=development

# Railway Data Simulator Configuration
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=10000

# Dynamic ML ETA Prediction Configuration
ETA_PREDICTION_INTERVAL_MS=30000

# Railway Data Provider Configuration
# Options: simulator | real | railkit
RAILWAY_DATA_PROVIDER=simulator

# RailKit V2 Provider Configuration
RAILKIT_API_KEY=

# Real Railway Data Provider (Legacy RailRadar) Configuration
RAILWAY_API_BASE_URL=
RAILWAY_API_KEY=
RAILWAY_API_TIMEOUT_MS=10000
RAILWAY_API_ENABLED=false
RAILWAY_POLL_INTERVAL_MS=10000
RAILWAY_CACHE_TTL_MS=5000

# Historical Telemetry Collector
HISTORICAL_COLLECTION_ENABLED=false
HISTORICAL_MONITORED_TRAINS=12952,12002
REAL_DATA_COLLECTION_INTERVAL_MS=300000

# Quota & Rate Limit Protection
RAILWAY_MONTHLY_QUOTA_LIMIT=30000
RAILWAY_QUOTA_OVERRIDE=false
RAILWAY_RATE_LIMIT_COOLDOWN_MS=300000
